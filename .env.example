# --- LLM（OpenAI 兼容）---
# 本地 Ollama（默认）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 云端：设 LLM_* 会覆盖上面的 OLLAMA_*（勿把真实 Key 提交进 Git）
# 阿里百炼（北京 OpenAI 兼容，Key 与地域须一致）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-key
# LLM_MODEL=qwen3.8-27b
#
# 智谱（Key 可 export GLM_API_KEY，或设 LLM_API_KEY）
# LLM_PROVIDER=glm
# LLM_MODEL=glm-4-flash
#
# DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

AGENT_MAX_STEPS=10

# 网页调研台（仅本机调试，勿裸奔公网）
WEB_HOST=127.0.0.1
WEB_PORT=8765

CONTEXT_TRIM_ENABLED=true
CONTEXT_MAX_TOKENS=8000
CONTEXT_TOOL_MAX_CHARS=2000
FETCH_MAX_BYTES=512000
FETCH_TIMEOUT_SEC=20
SEARCH_TIMEOUT_SEC=12
SEARCH_BUDGET_SEC=28
REPORTS_DIR=reports
SAVE_MARKDOWN_MAX_BYTES=512000
HN_MAX_RESULTS=15
RSS_MAX_ENTRIES=15
RSS_MAX_BYTES=512000
SOURCES_MAX_IN_PROMPT=25
